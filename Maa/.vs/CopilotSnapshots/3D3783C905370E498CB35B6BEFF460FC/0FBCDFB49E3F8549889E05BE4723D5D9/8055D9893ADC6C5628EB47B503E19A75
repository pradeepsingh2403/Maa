        // === Helper functions for cleaner UI generation ===
        private Control CreateLabeledTextBox(string labelText, string name, int x, int y)
        {
            var lbl = new Label() { Text = labelText, Location = new System.Drawing.Point(x, y), AutoSize = true };
            var txt = new TextBox() { Name = name, Location = new System.Drawing.Point(x + 120, y - 3), Width = 200 };
            var panel = new Panel() { Location = new System.Drawing.Point(x, y), Width = 400, Height = 30 };
            panel.Controls.Add(lbl);
            panel.Controls.Add(txt);
            return panel;
        }

        private Control CreateLabeledComboBox(string labelText, string name, int x, int y)
        {
            var lbl = new Label() { Text = labelText, Location = new System.Drawing.Point(x, y), AutoSize = true };
            var cmb = new ComboBox() { Name = name, Location = new System.Drawing.Point(x + 120, y - 3), Width = 200, DropDownStyle = ComboBoxStyle.DropDownList };
            var panel = new Panel() { Location = new System.Drawing.Point(x, y), Width = 400, Height = 30 };
            panel.Controls.Add(lbl);
            panel.Controls.Add(cmb);
            return panel;
        }

        private Control CreateLabeledDatePicker(string labelText, string name, int x, int y)
        {
            var lbl = new Label() { Text = labelText, Location = new System.Drawing.Point(x, y), AutoSize = true };
            var dtp = new DateTimePicker() { Name = name, Location = new System.Drawing.Point(x + 120, y - 3), Width = 200, Format = DateTimePickerFormat.Short };
            var panel = new Panel() { Location = new System.Drawing.Point(x, y), Width = 400, Height = 30 };
            panel.Controls.Add(lbl);
            panel.Controls.Add(dtp);
            return panel;
        }

        private Control CreateLabeledMultilineTextBox(string labelText, string name, int x, int y, int height)
        {
            var lbl = new Label() { Text = labelText, Location = new System.Drawing.Point(x, y), AutoSize = true };
            var txt = new TextBox() { Name = name, Location = new System.Drawing.Point(x + 120, y - 3), Width = 200, Height = height, Multiline = true, ScrollBars = ScrollBars.Vertical };
            var panel = new Panel() { Location = new System.Drawing.Point(x, y), Width = 400, Height = height + 20 };
            panel.Controls.Add(lbl);
            panel.Controls.Add(txt);
            return panel;
        }
    }
