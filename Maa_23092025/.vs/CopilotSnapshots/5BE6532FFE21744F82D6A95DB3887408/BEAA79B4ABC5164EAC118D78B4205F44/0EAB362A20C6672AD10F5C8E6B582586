        private Dictionary<string, RolePermission> LoadAllRolePermissions(int roleId)
        {
            Dictionary<string, RolePermission> permissions = new Dictionary<string, RolePermission>();

            try
            {
                string connStr = GlobalFunctions.ConnString;
                using (var con = new MySqlConnection(connStr))
                {
                    con.Open();
                    string sql = @"SELECT m.form_name, rp.can_save, rp.can_update, rp.can_delete, rp.can_view, rp.can_export
                           FROM modules m
                           LEFT JOIN role_permissions rp 
                           ON m.id = rp.module_id AND rp.role_id = @roleId
                           WHERE m.status = 1";

                    using (var cmd = new MySqlCommand(sql, con))
                    {
                        cmd.Parameters.AddWithValue("@roleId", roleId);

                        using (var reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                RolePermission rp = new RolePermission
                                {
                                    CanSave = reader["can_save"] != DBNull.Value ? Convert.ToBoolean(reader["can_save"]) : false,
                                    CanUpdate = reader["can_update"] != DBNull.Value ? Convert.ToBoolean(reader["can_update"]) : false,
                                    CanDelete = reader["can_delete"] != DBNull.Value ? Convert.ToBoolean(reader["can_delete"]) : false,
                                    CanView = reader["can_view"] != DBNull.Value ? Convert.ToBoolean(reader["can_view"]) : false,
                                    CanExport = reader["can_export"] != DBNull.Value ? Convert.ToBoolean(reader["can_export"]) : false
                                };

                                string formName = reader["form_name"].ToString();
                                permissions[formName] = rp;
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error loading role permissions: " + ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }

            return permissions;
        }

        private void ApplyMenuPermissions(int roleId)
        {
            Dictionary<string, RolePermission> permissions = LoadAllRolePermissions(roleId);

            foreach (ToolStripMenuItem item in menuStrip1.Items)  // menuStrip1 must exist
            {
                ApplyPermissionToMenu(item, permissions);
            }
        }

        private void ApplyPermissionToMenu(ToolStripMenuItem menuItem, Dictionary<string, RolePermission> permissions)
        {
            if (permissions.ContainsKey(menuItem.Name))
            {
                var perm = permissions[menuItem.Name];
                menuItem.Enabled = perm.CanView; // enable/disable based on permission
            }

            // Recursively check dropdown items
            foreach (ToolStripItem subItem in menuItem.DropDownItems)
            {
                if (subItem is ToolStripMenuItem subMenuItem)
                {
                    ApplyPermissionToMenu(subMenuItem, permissions);
                }
            }
        }

